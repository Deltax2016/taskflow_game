# Скопируйте в .env и заполните значения:  cp .env.example .env

# --- База данных ---
# Для docker compose значение переопределяется в compose (host = db).
# Для локального запуска бэкенда используйте host = localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/support

# --- Выбор реализации агента ---
# simple    = RAG + LLM (без саморефлексии)
# full      = полноценный агент, сам решает и эскалирует (занятие 1)
# langgraph = граф состояний: retry policy, бюджет, авто-эскалация тира, HITL (занятие 2)
AGENT_TYPE=langgraph

# --- LLM через OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=sk-or-...ВАШ_КЛЮЧ...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.1

# --- RAG / ретривер ---
# local = поиск по файлам knowledge_base | qdrant = векторный поиск (профиль qdrant)
RETRIEVER_TYPE=local
KNOWLEDGE_BASE_DIR=knowledge_base
RAG_TOP_K=3
QDRANT_URL=http://qdrant:6333

# --- Порог уверенности агента (ниже — эскалация человеку) ---
MIN_CONFIDENCE=0.6

# ═══════════════════════════════════════════════════════════════════════
# Ниже — только для AGENT_TYPE=langgraph
# ═══════════════════════════════════════════════════════════════════════

# --- Персистентность графа (checkpoint) ---
# postgres = переживает рестарт контейнера (нужно для HITL — тикет может
#            ждать оператора часами) | memory = только для быстрой локальной
#            разработки, состояние теряется при перезапуске процесса.
LANGGRAPH_CHECKPOINTER=postgres
# Другой драйвер (psycopg), чем DATABASE_URL (asyncpg) — у чекпоинтера
# LangGraph свой клиент к той же базе. Для docker compose host = db,
# для локального запуска — localhost (как и DATABASE_URL выше).
CHECKPOINTER_DSN=postgresql://postgres:postgres@localhost:5432/support

# --- Бюджет: защита от runaway / Token DoS ---
AGENT_MAX_STEPS=4
AGENT_MAX_SECONDS=25

# --- Retry Policy для узлов, которые ходят в LLM/RAG по сети ---
AGENT_RETRY_MAX_ATTEMPTS=3
AGENT_RETRY_INITIAL_INTERVAL=0.5

# --- Авто-маршрутизация: дешёвый режим → эскалация по триггеру качества ---
# Пусто = второй проход той же моделью с temperature=0. Впишите более сильную
# модель для настоящей эскалации тира, например: openai/gpt-4o
AGENT_ESCALATION_MODEL=

# --- Human-in-the-Loop: средний порог уверенности ---
# [human_approval_threshold, min_confidence) → черновик ждёт одобрения
# оператора. Ниже human_approval_threshold → обычная эскалация без черновика.
HUMAN_APPROVAL_THRESHOLD=0.35
